{
    "terminal": {
        "detect_venv": {
            "on": {
                "directories": [
                    ".env",
                    "env",
                    ".venv",
                    "venv",
                    ".pixi/envs/default"
                ],
                "activate_script": "default"
            }
        }
    },
    "languages": {
        "Python": {
            "language_servers": ["ruff", "ty", "basedpyright"],
            "format_on_save": "on",
        }
    }
}
