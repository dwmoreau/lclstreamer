{
  "lsp": {
    "python": [
      {
        "command": "pylsp",
        "enabled": true,
        "args": [],
        "auto_start": true,
        "root_markers": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json", ".git"],
        "initialization_options": {
          "pylsp": {
            "plugins": {
              "jedi": {
                "environment": ".pixi/envs/default/bin/python"
              },
              "pylsp_mypy": {
                "enabled": true,
                "live_mode": true,
                "overrides": ["--python-executable", ".pixi/envs/default/bin/python", true]
              },
              "pycodestyle": {
                "enabled": false
              },
              "pyflakes": {
                "enabled": false
              },
              "mccabe": {
                "enabled": false
              },
              "pylint": {
                "enabled": false
              }
            }
          }
        },
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      },
      {
        "command": "ruff",
        "enabled": true,
        "args": ["server"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      },
      {
        "command": "ty",
        "enabled": true,
        "args": ["server"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      }
    ]
  }
}
