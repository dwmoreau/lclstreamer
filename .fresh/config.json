{
  "lsp": {
    "python": [
      {
        "name": "basedpyright",
        "command": "basedpyright-langserver",
        "args": ["--stdio"],
        "root_markers": ["pyrightconfig.json", "pyproject.toml", ".git"]
      },
      {
        "command": "ruff",
        "enabled": true,
        "args": ["server"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      },
      {
        "command": "ty",
        "enabled": true,
        "args": ["server"],
        "auto_start": true,
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      }
    ]
  }
}
